{
  "name": "todo-list-web",
  "private": true,
  "version": "1.0.0",
  "description": "我的待办清单",
  "author": "zxyaizht",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.zxyaizht.todolist",
    "productName": "我的待办清单",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "我的待办清单-便携版.${ext}"
    }
  }
}
