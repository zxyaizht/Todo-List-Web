/* 全局样式与共用组件（主列表 / 回收站共用）
 * 设计令牌沿用网页版 style.css，几何尺寸换算成 rpx（1px ≈ 2rpx @375pt） */

page {
  /* 这里的静态值 = 默认主题色 #2563eb 由 core.deriveShades() 推导出的结果。
     主题是默认色时页面不加内联 CSS 变量（见 app.js），靠的就是这套静态值，
     两者必须保持一致；换主题时才写内联变量覆盖。 */
  --primary: #2563eb;
  --primary-rgb: 37, 99, 235;
  --primary-dark: #1249c1;
  --primary-light: #c5d6fb;
  --primary-soft: #e7eefd;
  --app-bg: #ecf1fe;
  --app-bg-2: #c8d9fe;
  --card-bg: #ffffff;
  --text: #1e293b;
  --text-muted: #64748b;
  --text-light: #94a3b8;
  --border: #e2e8f0;
  --success: #22c55e;
  --danger: #ef4444;
  --priority-high: #ef4444;
  --priority-high-soft: #fef2f2;
  --priority-medium: #f59e0b;
  --priority-medium-soft: #fffbeb;
  --priority-low: #22c55e;
  --priority-low-soft: #f0fdf4;
  /* 「无」等级：固定灰色，**不跟随主题色**（用户要求：选无时圆和沙漏都是灰的） */
  --priority-none: #94a3b8;
  --priority-none-soft: #f1f5f9;
  --radius-sm: 20rpx;
  --radius: 28rpx;

  background: #f0f4f8;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1.5;
}

.app {
  min-height: 100vh;
  padding: 28rpx 24rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, var(--app-bg), var(--app-bg-2));
}

/* ── 顶部 ── */

.header {
  padding: 8rpx 4rpx 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
}

.header-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

/* ── 添加任务表单 ── */

.form {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx;
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

/* 输入控件统一用 textarea（见 index.wxml 注释：部分安卓输入法在 input 里
 * 输入英文时候选词条会闪）。auto-height 下 style.height 不生效，
 * 所以用 min-height + line-height 固定"单行"时的视觉高度。 */
.form-input {
  flex: 1;
  min-width: 0;
  min-height: 80rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 44rpx;
  color: var(--text);
  background: var(--primary-soft);
  border-radius: var(--radius-sm);
}

.form-btn {
  flex-shrink: 0;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--primary);
  border-radius: var(--radius-sm);
}

/* ── 优先级选择（添加任务用） ── */

.priority-select {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.priority-label {
  font-size: 24rpx;
  color: var(--text-light);
  margin-right: 4rpx;
}

.priority-option {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
}

.priority-option.priority-high {
  color: var(--priority-high);
  background: var(--priority-high-soft);
}

.priority-option.priority-medium {
  color: var(--priority-medium);
  background: var(--priority-medium-soft);
}

.priority-option.priority-low {
  color: var(--priority-low);
  background: var(--priority-low-soft);
}

/* 「无」：灰色的胶囊（选中的描边由 .selected 统一负责） */
.priority-option.priority-none {
  color: var(--priority-none);
  background: var(--priority-none-soft);
}

.priority-option.selected {
  border-color: currentColor;
}

/* ── 搜索 ── */

.search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  background: var(--primary-soft);
  border: 4rpx solid transparent;
  border-radius: var(--radius-sm);
}

.search-input {
  flex: 1;
  min-width: 0;
  min-height: 82rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 42rpx;
  color: var(--text);
}

.search-clear {
  flex-shrink: 0;
  padding: 8rpx 10rpx;
  font-size: 26rpx;
  color: var(--text-light);
}

.search-hint {
  margin: 12rpx 4rpx 0;
  font-size: 24rpx;
  color: var(--text-muted);
}

.search-hint.no-match {
  color: var(--danger);
}

/* ── 工具行：第一行「排序 + 撤回/取消撤回」，下面两行是「轻重」「缓急」两行筛选 ── */

.list-toolbar {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 20rpx 0 16rpx;
}

.toolbar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 「三个下拉按钮」在左、「撤回箭头」在右，窄屏放不下时换行，不要互相挤压 */
  flex-wrap: wrap;
  gap: 12rpx;
}

.toolbar-menus {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  min-width: 0;
}

/* 列表空时工具栏只剩撤回/取消撤回两个箭头：居中，不要孤零零挂在左边
 * （工具行是纵向排列，所以这里要居中靠 align-items 而不是 justify-content） */
.list-toolbar.solo {
  align-items: center;
}

/* 撤回 / 取消撤回：夹在排序与优先级筛选中间。
 * 实心主题色 + 白字，与「添加」按钮同款（用户要求"较深色"）；不可用时整颗变淡。 */
.undo-group {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.undo-btn {
  width: 58rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 32rpx;
  color: #ffffff;
  background: var(--primary);
  border-radius: var(--radius-sm);
}

.undo-btn.disabled {
  opacity: 0.35;
}

/* ── 路径筛选式下拉菜单（排序 / 轻重 / 缓急 三个按钮共用一套）──
 * 按钮排在同一行，点开后下面展开一张卡片列出选项、当前项打勾，箭头旋转 180°。
 * 全屏透明蒙层负责"点别处收起"；z-index：蒙层 90、下拉卡片 91。
 * ⚠️ `.menu-wrap` **千万不要设 z-index** —— 一旦设了它就是新的层叠上下文，
 * 里面的卡片再高的 z-index 也会被蒙层盖住。 */

.menu-wrap {
  position: relative;
  flex-shrink: 0;
}

.menu-btn {
  position: relative;
  /* 按钮要浮在蒙层之上（92 > 90），否则菜单开着时点另一个按钮会被蒙层吃掉、
     必须先关再点（两次点击）。下拉卡片 91 夹在中间：盖住蒙层、但不挡按钮。 */
  z-index: 92;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--primary-soft);
  border: 2rpx solid rgba(var(--primary-rgb), 0.2);
  border-radius: 999rpx;
}

/* 有条件生效时染成主题色，一眼看出"这个是开着的" */
.menu-btn.on {
  color: var(--primary);
}

.menu-btn-label {
  white-space: nowrap;
}

/* 当前档位的小圆点（跟等级同一个色，选「全部」时是浅灰） */
.menu-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--border);
}

.menu-dot.priority-none { background: var(--priority-none); }
.menu-dot.priority-low { background: var(--priority-low); }
.menu-dot.priority-medium { background: var(--priority-medium); }
.menu-dot.priority-high { background: var(--priority-high); }

/* 箭头：展开时转 180°（就是用户要的那个动画） */
.menu-caret {
  font-size: 20rpx;
  line-height: 1;
  transition: transform 0.22s ease;
}

.menu-btn.open .menu-caret {
  transform: rotate(180deg);
}

.menu-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
}

.menu-pop {
  position: absolute;
  top: calc(100% + 10rpx);
  left: 0;
  z-index: 91;
  min-width: 240rpx;
  max-height: 560rpx;
  overflow-y: auto;
  padding: 8rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.16);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
  color: var(--text);
  border-radius: 14rpx;
}

.menu-item.picked {
  color: var(--primary);
  background: var(--primary-soft);
}

/* 按下只是底色变一下，**不动图标颜色**（用户不要"变浅再变深"那种过渡） */
.menu-item-hover {
  background: var(--primary-soft);
}

.menu-item-text {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.menu-check {
  flex-shrink: 0;
  font-size: 24rpx;
}

/* ── 操作行：两行各 4 个，等宽 ── */

.action-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

/* 挪到任务清单下方的操作行（清空类 / 恢复类）：和上面的清单或分页拉开距离 */
.action-row-bottom {
  margin-top: 28rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
  padding: 18rpx 8rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
  /* 文字换行显示：宁可占两行也要把按钮说明写全，不截断 */
  white-space: normal;
  word-break: break-word;
  color: var(--primary);
  background: var(--primary-soft);
  border: 2rpx solid rgba(var(--primary-rgb), 0.25);
  border-radius: var(--radius-sm);
}

.action-btn.filter-active {
  color: #ffffff;
  background: var(--primary);
  border-color: var(--primary);
}

.action-btn.disabled {
  opacity: 0.45;
}

/* 完成所有（成功色） */
.action-btn.complete {
  color: var(--success);
  background: #f0fdf4;
  border-color: rgba(34, 197, 94, 0.3);
}

/* ── 列表 ── */

.list {
  margin-top: 8rpx;
}

.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--border);
  border-left: 8rpx solid var(--border);
  border-radius: var(--radius-sm);
}

.item.priority-high {
  border-left-color: var(--priority-high);
}

.item.priority-medium {
  border-left-color: var(--priority-medium);
}

.item.priority-low {
  border-left-color: var(--priority-low);
}

/* 「无」：左侧竖条也是灰的（不跟主题） */
.item.priority-none {
  border-left-color: var(--priority-none);
}

.item.done {
  opacity: 0.72;
}

.badge {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  border-radius: 50%;
}

.badge.priority-high {
  background: var(--priority-high);
}

.badge.priority-medium {
  background: var(--priority-medium);
}

.badge.priority-low {
  background: var(--priority-low);
}

/* 「无」：灰色实心圆（不跟主题） */
.badge.priority-none {
  background: var(--priority-none);
}

/* ── 缓急沙漏（在任务名右边、添加日期左边）──
 * 必须用 CSS 画：emoji ⏳ 是彩色字形，CSS 的 color 改不了它的颜色，
 * 而这里**只能靠颜色**表达缓急程度。
 * 拟物：上下两块"木板"比玻璃体略宽 + 圆角（做出厚度），
 * 上半横截面（还剩沙的那半）半透明 —— 像隔着玻璃看，下半是沉下来的沙。 */
.urgency-icon {
  position: relative;
  flex-shrink: 0;
  width: 34rpx;
  height: 42rpx;
  box-sizing: border-box;
  color: var(--priority-none);
  border-top: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  border-radius: 3rpx;
}

.urgency-icon::before,
.urgency-icon::after {
  content: '';
  position: absolute;
  left: 1rpx;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
}

/* 上半：玻璃 + 还没落完的沙（半透明，透出玻璃感） */
.urgency-icon::before {
  top: 0;
  border-top: 16rpx solid currentColor;
  opacity: 0.55;
}

/* 下半：落下来的沙（实心） */
.urgency-icon::after {
  bottom: 0;
  border-bottom: 16rpx solid currentColor;
}

.urgency-icon.urgency-none {
  color: var(--priority-none);
}

.urgency-icon.urgency-low {
  color: var(--priority-low);
}

.urgency-icon.urgency-medium {
  color: var(--priority-medium);
}

.urgency-icon.urgency-high {
  color: var(--priority-high);
}

.check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 24rpx;
  color: transparent;
  border: 3rpx solid var(--border);
  border-radius: 10rpx;
}

.check.checked {
  color: #ffffff;
  background: var(--primary);
  border-color: var(--primary);
}

.item-text {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: var(--text);
  word-break: break-all;
}

.item.done .item-text {
  color: var(--text-light);
  text-decoration: line-through;
}

/* 搜索高亮片段 */
.hl {
  color: var(--primary);
  font-weight: 600;
}

.item-date {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--text-light);
  background: var(--primary-soft);
  border-radius: 10rpx;
}

.item-op {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  color: var(--text-light);
}

.item-op.del {
  color: var(--danger);
}

/* 回收站里的颜色条目 */
.color-chip {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
}

.kind-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  background: #f1f5f9;
  border-radius: 10rpx;
}

/* ── 空态 ── */

.empty {
  padding: 90rpx 24rpx;
  text-align: center;
  background: var(--primary-soft);
  border: 4rpx dashed var(--border);
  border-radius: var(--radius-sm);
}

.empty-icon {
  font-size: 72rpx;
}

.empty-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

/* ── 分页 ── */

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 24rpx;
}

.page-btn {
  padding: 14rpx 26rpx;
  font-size: 25rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border: 2rpx solid rgba(var(--primary-rgb), 0.25);
  border-radius: 999rpx;
}

.page-btn.disabled {
  opacity: 0.45;
}

.page-indicator {
  font-size: 25rpx;
  color: var(--text-muted);
}

/* 页码可点击：点一下输入页码直接跳页（三个页面通用）。
 * 虚线 + 主题色 = "这里能点"的提示，与设置页可点数值同款。 */
.page-indicator.tappable {
  display: inline-block;
  padding: 2rpx 10rpx;
  color: var(--primary);
  border-bottom: 2rpx dashed var(--border);
}

/* ── 页码跳转弹窗（自绘：平台的 wx.showModal 会自动聚焦输入框，一点页码键盘就弹出来） ── */

.page-dialog {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.45);
  /* 键盘弹出时用 padding-bottom 把卡片顶到键盘上方（见 WXML 里绑的 pageKeyHeight）。
     固定定位的蒙层不会跟着平台"自动上推页面"动，所以自己来；加过渡让它平滑地跟着键盘走。 */
  transition: padding-bottom 0.25s ease-out;
}

.page-dialog-card {
  width: 78%;
  max-width: 560rpx;
  padding: 36rpx 32rpx 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.2);
}

.page-dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  text-align: center;
}

/* 输入框**不聚焦**：用户点它才会弹键盘。
 * 这里用的是 <input type="number">（不是 textarea）：页码只可能是数字，
 * 只有 input 的 type 能把键盘切成数字键盘，用户不用自己切输入法。
 * 单行高度靠 height/min-height + line-height 撑（82 = 20 + 42 + 20） */
.page-dialog-input {
  width: 100%;
  height: 82rpx;
  min-height: 82rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 42rpx;
  color: var(--text);
  background: var(--primary-soft);
  border-radius: var(--radius-sm);
}

.page-dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.page-dialog-btn {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-muted);
  background: #f1f5f9;
  border-radius: var(--radius-sm);
}

.page-dialog-btn.primary {
  color: #ffffff;
  background: var(--primary);
}

/* ── 等级相关的共用布局（主列表与任务组子页面都要用，所以放在全局） ── */

/* 等级按钮那一行：齿轮 / 等级 / 历史记录排一排；窄屏放不下整行换行，别互相挤压 */
.priority-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

/* 靠左那一组（齿轮 + 两个等级按钮），历史记录仍贴右 */
.priority-row-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.search-icon {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-light);
}

/* 任务行里的圆形（轻重）：外面套一层把点按区域从 44rpx 放大到 68rpx，
   负 margin 把多出来的内边距抵消掉，所以视觉位置不变 */
.badge-hit {
  flex-shrink: 0;
  padding: 12rpx;
  margin: -12rpx;
}

/* 新建任务那一行的两个等级按钮（圆=轻重、沙漏=缓急）：同样套一层放大点按区域 */
.level-pick {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 12rpx;
  margin: -12rpx;
}

/* 任务行里的沙漏（缓急）：同样放大点按区域（沙漏本身只有 34rpx 宽） */
.urgency-hit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 12rpx;
  margin: -12rpx;
}

/* 改等级弹窗：两行（轻重 / 缓急），每行是「标签 + 四个胶囊」，居中摆放 */
.level-dialog-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

/* ── 任务组那一行（像文件夹）：左边一个 90° 右箭头 + 组名 + 任务数 ── */

.item-group {
  border-left-color: var(--primary);
  background: var(--primary-soft);
}

.group-arrow {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--primary);
}

.group-name {
  color: var(--primary);
  font-weight: 600;
}

.group-count {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--card-bg);
  border-radius: 10rpx;
}

/* ── 分页行上的「合并 / 完成 / 取消」 ──
 * 合并按钮颜色比旁边的清空类更深：清空类是浅底、这个是实心主题色（用户要求"更深、依旧跟随主题"）。 */
.pagination-merge {
  justify-content: space-between;
}

.pagination-pages {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.merge-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--primary);
  border: 2rpx solid transparent;
  border-radius: 999rpx;
}

/* 「取消」用浅色，别和「完成」抢注意力 */
.merge-btn.cancel {
  color: var(--text-muted);
  background: var(--primary-soft);
  border-color: rgba(var(--primary-rgb), 0.2);
}

/* ── 合并模式：勾选框变成"要不要加入新组" ──
 * 故意换成**圆形 + 虚线**，和普通模式下那套"圆角方块 + 实心"（表示完成）一眼就能区分。 */
.item.merge-pick {
  border-left-color: var(--primary);
}

.item.merge-picked {
  background: var(--primary-soft);
}

.check.picking {
  border-radius: 50%;
  border-style: dashed;
}

.check.picking.picked {
  border-style: solid;
  border-color: var(--primary);
  color: #ffffff;
  background: var(--primary);
}

/* ── 拖动任务去合并：跟随手指的小浮标 + 落点高亮 ── */

.drag-ghost {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 300;
  padding: 22rpx 24rpx;
  font-size: 29rpx;
  color: var(--text);
  background: var(--card-bg);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-sm);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.2);
  opacity: 0.96;
}

.item.dragging {
  opacity: 0.4;
}

.item.drag-over {
  border-color: var(--primary);
  background: var(--primary-soft);
}
