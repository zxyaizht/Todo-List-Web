<!-- 拖动任务时临时禁止页面滚动（手指在行上滑动不能被当成页面滚动）。
     page-meta 必须是页面里第一个节点，且只能有一个。 -->
<page-meta page-style="{{dragging ? 'overflow: hidden;' : ''}}"></page-meta>

<view class="app" style="{{themeStyle}}">
  <!-- 这里用 textarea 而不是 input：部分安卓输入法在 <input> 里输入英文时，
       键盘上方的候选词条会"打一个字母闪一下"（微信官方已知问题），换成 textarea 就没有。
       auto-height 让它平时就是单行高度，任务名很长时才自动长高。 -->
  <view class="form">
    <textarea
      class="form-input"
      value="{{inputValue}}"
      placeholder="今天要做什么？"
      maxlength="200"
      auto-height="{{true}}"
      disable-default-padding="{{true}}"
      confirm-type="done"
      confirm-hold="{{true}}"
      hold-keyboard="{{true}}"
      cursor-spacing="24"
      focus="{{inputFocus}}"
      bindinput="onInput"
      bindconfirm="addTodo"
      bindblur="onInputBlur"
    />
    <view class="form-btn" bindtap="addTodo">➕ 添加</view>
  </view>

  <!-- 齿轮 + 轻重 + 缓急 + 历史记录同一行。等级不用把「高中低」全列出来，
       各留一个按钮，点一下切一级（无 → 轻 → 中 → 重 / 无 → 缓 → 中 → 急），省地方 -->
  <view class="priority-row">
    <view class="priority-row-left">
      <view class="settings-gear" bindtap="goSettings" aria-label="设置">⚙️</view>
      <!-- 按下不做"变浅再变深"的过渡（用户要求）：换档时图标颜色直接切换 -->
      <view class="level-pick" bindtap="cycleWeight" aria-label="轻重">
        <view class="badge priority-{{priority}}">{{weightLabel}}</view>
      </view>
      <view class="level-pick" bindtap="cycleUrgency" aria-label="缓急">
        <view class="urgency-icon urgency-{{urgency}}"></view>
      </view>
    </view>
    <view class="history-btn" bindtap="goHistory">🕘 历史记录{{historyCount > 0 ? ' (' + historyCount + ')' : ''}}</view>
  </view>

  <view class="search">
    <text class="search-icon">🔍</text>
    <!-- 同样用 textarea 避开 input 的输入法闪烁（见上方表单注释） -->
    <textarea
      class="search-input"
      value="{{search}}"
      placeholder="搜索待办事项"
      auto-height="{{true}}"
      disable-default-padding="{{true}}"
      confirm-type="search"
      bindinput="onSearch"
    />
    <view wx:if="{{search}}" class="search-clear" bindtap="clearSearch">✕</view>
  </view>
  <view wx:if="{{hint}}" class="search-hint {{hintNoMatch ? 'no-match' : ''}}">{{hint}}</view>

  <!-- 工具栏：排序 / 轻重 / 缓急 三个"路径筛选式"下拉按钮同一行，撤回箭头贴在右侧。
       点按钮展开一张卡片列表（当前项打勾、箭头转 180°），点别处收起来。
       任务被清空后排序/筛选没意义了，但**撤回箭头必须留着** ——
       「清空全部」之后正是最需要撤回的时候（列表空了，如果连箭头一起消失就等于没救）。 -->
  <block wx:if="{{total > 0 || canUndo || canRedo}}">
    <view class="list-toolbar {{total > 0 ? '' : 'solo'}}">
      <view class="toolbar-top">
        <view class="toolbar-menus">
          <!-- 排序：原来是 wx.showActionSheet，但它的 itemList 最多 6 项，
               加上「缓急」的两个选项就超了，所以改成同一套自绘下拉 -->
          <view wx:if="{{total > 0}}" class="menu-wrap">
            <view
              class="menu-btn {{sort !== 'default' ? 'on' : ''}} {{openMenu === 'sort' ? 'open' : ''}}"
              bindtap="toggleMenu"
              data-menu="sort"
              aria-label="排序"
            >
              <text class="menu-btn-label">⇅ {{sortLabel}}</text>
              <text class="menu-caret">▾</text>
            </view>
            <view wx:if="{{openMenu === 'sort'}}" class="menu-pop">
              <view
                wx:for="{{sortOrder}}"
                wx:key="*this"
                class="menu-item {{sort === item ? 'picked' : ''}}"
                data-menu="sort"
                data-sort="{{item}}"
                bindtap="pickSort"
                hover-class="menu-item-hover"
              >
                <text class="menu-item-text">{{sortLabels[item]}}</text>
                <text class="menu-check">{{sort === item ? '✓' : ''}}</text>
              </view>
            </view>
          </view>

          <!-- 轻重筛选（全部 / 无 / 轻 / 中 / 重）：圆点显示当前档位的颜色 -->
          <view wx:if="{{total > 0}}" class="menu-wrap">
            <view
              class="menu-btn {{priorityFilter !== 'all' ? 'on' : ''}} {{openMenu === 'weight' ? 'open' : ''}}"
              bindtap="toggleMenu"
              data-menu="weight"
              aria-label="轻重筛选"
            >
              <view class="menu-dot priority-{{priorityFilter}}"></view>
              <text class="menu-btn-label">轻重</text>
              <text class="menu-caret">▾</text>
            </view>
            <view wx:if="{{openMenu === 'weight'}}" class="menu-pop">
              <view
                wx:for="{{levelFilterOrder}}"
                wx:key="*this"
                class="menu-item {{priorityFilter === item ? 'picked' : ''}}"
                data-menu="weight"
                data-level="{{item}}"
                bindtap="pickLevelFilter"
                hover-class="menu-item-hover"
              >
                <view class="menu-dot priority-{{item}}"></view>
                <text class="menu-item-text">{{weightFilterLabels[item]}}</text>
                <text class="menu-check">{{priorityFilter === item ? '✓' : ''}}</text>
              </view>
            </view>
          </view>

          <!-- 缓急筛选（全部 / 无 / 缓 / 中 / 急） -->
          <view wx:if="{{total > 0}}" class="menu-wrap">
            <view
              class="menu-btn {{urgencyFilter !== 'all' ? 'on' : ''}} {{openMenu === 'urgency' ? 'open' : ''}}"
              bindtap="toggleMenu"
              data-menu="urgency"
              aria-label="缓急筛选"
            >
              <view class="menu-dot priority-{{urgencyFilter}}"></view>
              <text class="menu-btn-label">缓急</text>
              <text class="menu-caret">▾</text>
            </view>
            <view wx:if="{{openMenu === 'urgency'}}" class="menu-pop">
              <view
                wx:for="{{levelFilterOrder}}"
                wx:key="*this"
                class="menu-item {{urgencyFilter === item ? 'picked' : ''}}"
                data-menu="urgency"
                data-level="{{item}}"
                bindtap="pickLevelFilter"
                hover-class="menu-item-hover"
              >
                <view class="menu-dot priority-{{item}}"></view>
                <text class="menu-item-text">{{urgencyFilterLabels[item]}}</text>
                <text class="menu-check">{{urgencyFilter === item ? '✓' : ''}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 撤回 / 取消撤回：实心主题色，与「添加」按钮同色 -->
        <view class="undo-group">
          <view class="undo-btn {{canUndo ? '' : 'disabled'}}" bindtap="undoAction" aria-label="撤回">↶</view>
          <view class="undo-btn {{canRedo ? '' : 'disabled'}}" bindtap="redoAction" aria-label="取消撤回">↷</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 拖动合并时跟随手指的小浮标（整行宽度、跟着 Y 走，像拎起一张卡片） -->
  <view wx:if="{{dragging}}" class="drag-ghost" style="top: {{dragY}}px">{{dragText}}</view>

  <!-- 下拉菜单的透明蒙层：点别处收起 -->
  <view wx:if="{{openMenu}}" class="menu-mask" catchtap="closeMenu"></view>

  <block wx:if="{{total > 0}}">
    <!-- 操作行（第一行）：筛选 + 完成所有/取消所有（清空类那 4 个挪到了清单下方） -->
    <view class="action-row">
      <view class="action-btn {{filter === 'all' ? 'filter-active' : ''}}" data-filter="all" bindtap="setFilter">全部</view>
      <view class="action-btn complete" bindtap="completeAll">{{completeAllLabel}}</view>
      <view class="action-btn {{filter === 'done' ? 'filter-active' : ''}}" data-filter="done" bindtap="setFilter">已完成 ({{completed}})</view>
      <view class="action-btn {{filter === 'active' ? 'filter-active' : ''}}" data-filter="active" bindtap="setFilter">未完成 ({{incomplete}})</view>
    </view>
  </block>

  <!-- 列表 -->
  <view class="list">
    <block wx:if="{{items.length > 0}}">
      <view
        wx:for="{{items}}"
        wx:key="key"
        class="item {{item.rowClass}}{{mergeMode && item.kind === 'todo' ? ' merge-pick' : ''}}{{pickedIds[item.id] ? ' merge-picked' : ''}}{{dragging && item.kind === 'todo' && item.id == dragId ? ' dragging' : ''}}{{dragOverId && item.id == dragOverId ? ' drag-over' : ''}}"
        data-id="{{item.id}}"
        bindlongpress="onItemLongPress"
        bindtouchmove="onItemTouchMove"
        bindtouchend="onItemTouchEnd"
      >
        <!-- 任务组：左边仍然是勾选框（点它 = 完成/取消完成组内全部任务），
             名字点开是改名，右边的箭头才是进组 -->
        <block wx:if="{{item.kind === 'group'}}">
          <view class="check {{item.allDone ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleGroupAll">✓</view>
          <view class="item-text group-name" data-id="{{item.id}}" bindtap="renameGroup">
            <text wx:for="{{item.segments}}" wx:for-item="seg" wx:key="i" class="{{seg.hit ? 'hl' : ''}}">{{seg.v}}</text>
          </view>
          <view class="group-arrow" data-id="{{item.id}}" bindtap="openGroup" aria-label="打开任务组">›</view>
          <view class="group-count">{{item.count}} 项</view>
          <view class="item-op del" data-id="{{item.id}}" bindtap="removeGroup">✕</view>
        </block>

        <!-- 普通任务 -->
        <block wx:else>
          <view class="check {{mergeMode ? ('picking' + (pickedIds[item.id] ? ' picked' : '')) : (item.done ? 'checked' : '')}}" data-id="{{item.id}}" bindtap="onCheckTap">✓</view>
          <view class="item-text" data-id="{{item.id}}" bindtap="editTodo">
            <text wx:for="{{item.segments}}" wx:for-item="seg" wx:key="i" class="{{seg.hit ? 'hl' : ''}}">{{seg.v}}</text>
          </view>
          <view class="badge-hit" data-id="{{item.id}}" bindtap="openLevelDialog" aria-label="轻重">
            <view class="badge priority-{{item.priority}}">{{item.weightLabel}}</view>
          </view>
          <view class="urgency-hit" data-id="{{item.id}}" bindtap="openLevelDialog" aria-label="缓急">
            <view class="urgency-icon urgency-{{item.urgency}}"></view>
          </view>
          <view wx:if="{{item.dateText}}" class="item-date">{{item.dateText}}</view>
          <view class="item-op del" data-id="{{item.id}}" bindtap="deleteTodo">✕</view>
        </block>
      </view>
    </block>
    <view wx:else class="empty">
      <view class="empty-icon">{{emptyIcon}}</view>
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-desc">{{emptyDesc}}</view>
    </view>
  </view>

  <!-- 分页行：最左边是「合并」（用户要求的位置），进入合并模式后它变成「完成」、最右出现「取消」。
       整行在 total > 0 时就渲染 —— 否则只有一页时分页行不显示，「合并」就点不到了。 -->
  <view wx:if="{{total > 0}}" class="pagination pagination-merge">
    <view class="merge-btn {{mergeMode ? 'done' : ''}}" bindtap="mergeAction">{{mergeMode ? '完成' + (pickedCount > 0 ? ' (' + pickedCount + ')' : '') : '合并'}}</view>
    <view class="pagination-pages">
      <block wx:if="{{visibleCount > 5}}">
        <view class="page-btn {{page <= 1 ? 'disabled' : ''}}" bindtap="prevPage">‹ 上一页</view>
        <text class="page-indicator tappable" bindtap="editPage">第 {{page}} / {{totalPages}} 页</text>
        <view class="page-btn {{page >= totalPages ? 'disabled' : ''}}" bindtap="nextPage">下一页 ›</view>
      </block>
    </view>
    <view wx:if="{{mergeMode}}" class="merge-btn cancel" bindtap="cancelMerge">取消</view>
  </view>

  <!-- 操作行（第二行）：清空类 4 个。用户要求与任务清单上下对调，所以放到清单下方；
       排序 / 优先级筛选 / 页码都保持原位不动。 -->
  <view wx:if="{{total > 0}}" class="action-row action-row-bottom">
    <view class="action-btn" bindtap="clearAll">⚡ 清空全部</view>
    <view class="action-btn" bindtap="completeClear">✅ 完成所有并清空</view>
    <view class="action-btn {{completed === 0 ? 'disabled' : ''}}" bindtap="clearDone">🗑️ 清空已完成{{completed > 0 ? ' (' + completed + ')' : ''}}</view>
    <view class="action-btn {{incomplete === 0 ? 'disabled' : ''}}" bindtap="clearIncomplete">🧹 清空未完成{{incomplete > 0 ? ' (' + incomplete + ')' : ''}}</view>
  </view>

  <!-- 新建任务组：给合并出来的组起名。打开就自动聚焦（键盘直接弹出来），
       什么都不输直接点确定就用默认名（placeholder 里实时算出「任务组N」）。
       键盘高度的处理复用跳页弹窗那套（pageKeyHeight + onPageDialogKeyboard）。 -->
  <view wx:if="{{groupDialog}}" class="page-dialog" style="padding-bottom: {{pageKeyHeight}}px">
    <view class="page-dialog-card">
      <view class="page-dialog-title">给任务组起个名字</view>
      <textarea
        class="page-dialog-input group-name-input"
        value="{{groupName}}"
        placeholder="{{groupPlaceholder}}"
        maxlength="30"
        auto-height="{{true}}"
        disable-default-padding="{{true}}"
        fixed="{{true}}"
        focus="{{true}}"
        auto-focus="{{true}}"
        adjust-position="{{false}}"
        confirm-type="done"
        cursor-spacing="24"
        bindinput="onGroupNameInput"
        bindconfirm="confirmGroupDialog"
        bindfocus="onPageDialogKeyboard"
        bindkeyboardheightchange="onPageDialogKeyboard"
      />
      <view class="page-dialog-actions">
        <view class="page-dialog-btn" bindtap="closeGroupDialog">取消</view>
        <view class="page-dialog-btn primary" bindtap="confirmGroupDialog">确定</view>
      </view>
    </view>
  </view>

  <!-- 改等级弹窗：一个弹窗两行（轻重 / 缓急），点任务上的圆形或沙漏都打开它。
       胶囊沿用「新建任务」那套 .priority-option，配色天然一致。 -->
  <view wx:if="{{levelDialog}}" class="page-dialog">
    <view class="page-dialog-card">
      <view class="page-dialog-title">修改等级</view>
      <view class="level-dialog-row">
        <text class="priority-label">轻重</text>
        <view
          wx:for="{{levelOrder}}"
          wx:key="*this"
          class="priority-option priority-{{item}} {{levelPick.priority === item ? 'selected' : ''}}"
          data-kind="priority"
          data-level="{{item}}"
          bindtap="pickLevel"
        >{{weightLabels[item]}}</view>
      </view>
      <view class="level-dialog-row">
        <text class="priority-label">缓急</text>
        <view
          wx:for="{{levelOrder}}"
          wx:key="*this"
          class="priority-option priority-{{item}} {{levelPick.urgency === item ? 'selected' : ''}}"
          data-kind="urgency"
          data-level="{{item}}"
          bindtap="pickLevel"
        >{{urgencyLabels[item]}}</view>
      </view>
      <view class="page-dialog-actions">
        <view class="page-dialog-btn" bindtap="closeLevelDialog">取消</view>
        <view class="page-dialog-btn primary" bindtap="confirmLevelDialog">确定</view>
      </view>
    </view>
  </view>

  <!-- 页码跳转弹窗：自绘（wx.showModal 的位置与键盘行为都不受控）。
       1) 输入框是 focus="{{true}}" → 弹窗一出现就聚焦，**键盘自动弹出来**，点完页码直接就能改，少点一下；
       2) 蒙层的 padding-bottom 跟着键盘高度走 → 整张卡片平滑移到键盘上方，不会被挡住。
       注意：输入框上的 adjust-position 必须关掉（固定定位的蒙层本来就不会跟着平台"上推页面"动，
       开着反而可能和上面的 padding 重复位移）。 -->
  <view wx:if="{{pageDialog}}" class="page-dialog" style="padding-bottom: {{pageKeyHeight}}px">
    <view class="page-dialog-card">
      <view class="page-dialog-title">跳转到第几页</view>
      <!-- 这里用 input 而不是 textarea：页码只可能是数字，input 的 type="number"
           能直接把键盘切成**数字键盘**（用户不用再自己切换输入法）。
           textarea 没有 type，给不了这个能力；而当初统一用 textarea 是为了躲开
           "安卓输入法在 input 里打英文时候选词条闪一下"，纯数字键盘不涉及字母，所以这里没这个顾虑。 -->
      <input
        class="page-dialog-input"
        type="number"
        maxlength="6"
        value="{{pageInput}}"
        placeholder="输入 1 ~ {{pageTotal}}"
        disable-default-padding="{{true}}"
        focus="{{true}}"
        auto-focus="{{true}}"
        adjust-position="{{false}}"
        confirm-type="go"
        bindinput="onPageDialogInput"
        bindconfirm="confirmPageDialog"
        bindfocus="onPageDialogKeyboard"
        bindkeyboardheightchange="onPageDialogKeyboard"
      />
      <view class="page-dialog-actions">
        <view class="page-dialog-btn" bindtap="closePageDialog">取消</view>
        <view class="page-dialog-btn primary" bindtap="confirmPageDialog">确定</view>
      </view>
    </view>
  </view>
</view>
