.topbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.topbar-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(255, 255, 255, 0.75);
  border: 2rpx solid rgba(var(--primary-rgb), 0.2);
  border-radius: var(--radius-sm);
}

.search-icon {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-light);
}
