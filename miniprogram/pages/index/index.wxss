/* 顶部：左边标题、右边齿轮。
   齿轮是页面内容的一部分（内容本来就在导航栏下方），并额外往下让了一点，
   和导航栏右上角的胶囊按钮拉开距离，避免误触 */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.header-main {
  min-width: 0;
}

.settings-gear {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 34rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(var(--primary-rgb), 0.2);
  border-radius: 50%;
  margin-top: 6rpx;
}

/* 优先级与历史记录同一行，页面更紧凑 */
.priority-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 20rpx;
}

.history-btn {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-soft);
  border: 2rpx solid rgba(var(--primary-rgb), 0.25);
  border-radius: 999rpx;
}

.search-icon {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-light);
}

/* 点优先级标签改优先级：外面套一层只是把点按区域从 44rpx 放大到 68rpx，
   负 margin 把多出来的内边距抵消掉，所以视觉位置和原来完全一样 */
.badge-hit {
  flex-shrink: 0;
  padding: 12rpx;
  margin: -12rpx;
}

.badge-hit-hover {
  opacity: 0.55;
}

/* 改优先级弹窗里的选择器：与「新建任务」那行同一套胶囊，居中摆放 */
.priority-dialog-select {
  justify-content: center;
  margin-top: 28rpx;
}
