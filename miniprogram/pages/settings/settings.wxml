<view class="app" style="{{themeStyle}}">
  <view class="header">
    <view class="header-title">⚙️ 设置</view>
    <view class="header-sub">主题色与音效</view>
  </view>

  <!-- 主题色 -->
  <view class="section">
    <view class="section-title">主题色</view>
    <view class="swatches">
      <view
        wx:for="{{presets}}"
        wx:key="hex"
        class="swatch {{theme === item.hex ? 'selected' : ''}}"
        style="background: {{item.hex}}"
        data-hex="{{item.hex}}"
        bindtap="pickTheme"
      >
        <text wx:if="{{theme === item.hex}}" class="swatch-check">✓</text>
      </view>
    </view>

    <view class="custom-row">
      <!-- 用 textarea 而不是 input：色值全是英文/符号，input 在部分安卓输入法下
           每敲一个字符候选词条就闪一下（微信官方已知问题），textarea 没有这个问题 -->
      <textarea
        class="custom-input"
        value="{{customInput}}"
        placeholder="输入色值，如 #ff8800 / ff8800 / rgb(255,0,0) / red"
        auto-height="{{true}}"
        disable-default-padding="{{true}}"
        confirm-type="done"
        confirm-hold="{{true}}"
        hold-keyboard="{{true}}"
        focus="{{colorFocus}}"
        bindinput="onCustomInput"
        bindconfirm="applyCustom"
        bindblur="onCustomBlur"
      />
      <view class="custom-btn" bindtap="applyCustom">应用</view>
    </view>

    <block wx:if="{{customColors.length > 0}}">
      <view class="saved-title">
        <text>最近用的颜色 ({{customCount}})</text>
        <text class="saved-tip">点色码复制，点右上角 × 删除</text>
      </view>
      <view class="saved-grid">
        <view wx:for="{{customColors}}" wx:key="*this" class="saved-item">
          <view class="saved-swatch-wrap">
            <view
              class="saved-swatch {{theme === item ? 'selected' : ''}}"
              style="background: {{item}}"
              data-hex="{{item}}"
              bindtap="applySaved"
            ></view>
            <view class="saved-remove" data-hex="{{item}}" catchtap="removeColor">✕</view>
          </view>
          <view class="saved-code" data-hex="{{item}}" bindtap="copyCode">{{item}}</view>
        </view>
      </view>

      <!-- 分页：与主列表 / 历史记录用的是同一套控件（全局样式 .pagination） -->
      <view wx:if="{{customTotalPages > 1}}" class="pagination">
        <view class="page-btn {{customPage <= 1 ? 'disabled' : ''}}" bindtap="prevColorPage">‹ 上一页</view>
        <text class="page-indicator tappable" bindtap="editPage">第 {{customPage}} / {{customTotalPages}} 页</text>
        <view class="page-btn {{customPage >= customTotalPages ? 'disabled' : ''}}" bindtap="nextColorPage">下一页 ›</view>
      </view>

      <view class="clear-colors" bindtap="clearAllColors">🗑️ 全部删除</view>
    </block>
  </view>

  <!-- 音效 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">音效</text>
      <view class="toggle {{allSoundOn ? 'on' : ''}}" data-key="master" bindtap="toggleMaster">
        <view class="toggle-knob"></view>
      </view>
    </view>
    <view class="sound-list">
      <view wx:for="{{soundRows}}" wx:key="key" class="sound-row">
        <text class="sound-label">{{item.label}}</text>
        <view class="toggle {{item.on ? 'on' : ''}}" data-key="{{item.key}}" bindtap="toggleSound">
          <view class="toggle-knob"></view>
        </view>
      </view>
    </view>

    <!-- 音效参数：音量 + 频率（颜色跟随主题；松手会用当前音高试听，点右侧数字可直接输入） -->
    <view class="slider-row">
      <text class="slider-label">音量</text>
      <slider
        class="slider"
        min="0"
        max="100"
        step="1"
        value="{{soundVolume}}"
        activeColor="{{theme}}"
        block-color="{{theme}}"
        backgroundColor="#e2e8f0"
        bindchange="onVolumeChange"
      />
      <text class="slider-value tappable" bindtap="editVolume">{{soundVolume}}%</text>
    </view>
    <view class="slider-row">
      <text class="slider-label">频率</text>
      <slider
        class="slider"
        min="0"
        max="87"
        step="1"
        value="{{soundKey}}"
        activeColor="{{theme}}"
        block-color="{{theme}}"
        backgroundColor="#e2e8f0"
        bindchange="onFreqChange"
      />
      <text class="slider-value wide tappable" bindtap="editPitch">{{soundNote}} · {{soundFreqHz}}Hz</text>
    </view>
    <view class="slider-tip">频率覆盖钢琴全音域（88 键：最左 A0、最右 C8，每格一个半音）。松开任一滑杆都会按当前音高试听一个钢琴音。点右侧数值可直接输入：音量填 0~100，频率可填音名（如 A#3）或 Hz（如 523）。</view>
  </view>

  <view class="footnote">数据保存在本机，不会上传服务器。</view>

  <!-- 页码跳转弹窗：自绘（wx.showModal 的位置与键盘行为都不受控）。
       1) 输入框是 focus="{{true}}" → 弹窗一出现就聚焦，**键盘自动弹出来**，点完页码直接就能改，少点一下；
       2) 蒙层的 padding-bottom 跟着键盘高度走 → 整张卡片平滑移到键盘上方，不会被挡住。 -->
  <view wx:if="{{pageDialog}}" class="page-dialog" style="padding-bottom: {{pageKeyHeight}}px">
    <view class="page-dialog-card">
      <view class="page-dialog-title">跳转到第几页</view>
      <textarea
        class="page-dialog-input"
        value="{{pageInput}}"
        placeholder="输入 1 ~ {{pageTotal}}"
        auto-height="{{true}}"
        disable-default-padding="{{true}}"
        fixed="{{true}}"
        focus="{{true}}"
        auto-focus="{{true}}"
        adjust-position="{{false}}"
        confirm-type="go"
        bindinput="onPageDialogInput"
        bindconfirm="confirmPageDialog"
        bindfocus="onPageDialogKeyboard"
        bindkeyboardheightchange="onPageDialogKeyboard"
      />
      <view class="page-dialog-actions">
        <view class="page-dialog-btn" bindtap="closePageDialog">取消</view>
        <view class="page-dialog-btn primary" bindtap="confirmPageDialog">确定</view>
      </view>
    </view>
  </view>
</view>
